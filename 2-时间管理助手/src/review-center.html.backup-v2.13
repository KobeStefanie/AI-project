<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>复盘中心 - 时间管理助手</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
            background: #f5f7fa;
            color: #2c3e50;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            font-size: 24px;
            color: #2c3e50;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-primary:hover {
            background: #2980b9;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn-secondary:hover {
            background: #7f8c8d;
        }

        .card {
            background: white;
            padding: 24px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .card h2 {
            font-size: 18px;
            margin-bottom: 16px;
            color: #34495e;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .goals-list {
            list-style: none;
            padding-left: 0;
        }

        .goals-list li {
            padding: 12px;
            background: #ecf0f1;
            border-radius: 6px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .week-selector {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .week-selector select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }

        .quick-select {
            display: flex;
            gap: 8px;
        }

        .quick-select button {
            padding: 6px 12px;
            font-size: 13px;
        }

        .history-item {
            padding: 16px;
            background: #f8f9fa;
            border-radius: 6px;
            margin-bottom: 12px;
            border-left: 4px solid #3498db;
        }

        .history-item-header {
            font-weight: bold;
            margin-bottom: 8px;
            color: #2c3e50;
        }

        .history-item-content {
            font-size: 14px;
            color: #7f8c8d;
            margin-bottom: 8px;
        }

        .history-item-actions {
            display: flex;
            gap: 8px;
        }

        .history-item-actions button {
            padding: 6px 12px;
            font-size: 13px;
        }

        #analysis-view {
            display: none;
        }

        .layer-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
            border-bottom: 2px solid #ecf0f1;
        }

        .layer-tab {
            padding: 12px 24px;
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 14px;
            color: #7f8c8d;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

        .layer-tab.active {
            color: #3498db;
            border-bottom-color: #3498db;
            font-weight: bold;
        }

        .layer-tab:hover {
            color: #2980b9;
        }

        .layer-content {
            display: none;
        }

        .layer-content.active {
            display: block;
        }

        .feelings-input textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            min-height: 80px;
            font-family: inherit;
            resize: vertical;
        }

        .data-stats, .contrast, .time-scale, .journey-map, .goal-alignment {
            margin-top: 20px;
        }

        .data-stats h3, .contrast h3, .time-scale h3, .journey-map h3, .goal-alignment h3 {
            font-size: 16px;
            margin-bottom: 12px;
            color: #34495e;
        }

        .stats-list {
            list-style: none;
            padding-left: 0;
        }

        .stats-list li {
            padding: 8px 12px;
            margin-bottom: 6px;
            border-left: 3px solid #3498db;
            background: #f8f9fa;
        }

        .contrast-list {
            list-style: none;
            padding-left: 0;
        }

        .contrast-list li {
            padding: 12px;
            margin-bottom: 8px;
            background: #fff3cd;
            border-left: 3px solid #ffc107;
            border-radius: 4px;
        }

        .trend-chart {
            padding: 16px;
            background: #f8f9fa;
            border-radius: 6px;
            margin-top: 12px;
        }

        .layer-navigation {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #ecf0f1;
        }

        /* 目标编辑模态框 */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            background: white;
            border-radius: 8px;
            padding: 24px;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h2 {
            font-size: 20px;
            color: #2c3e50;
        }

        .modal-close {
            font-size: 24px;
            color: #95a5a6;
            cursor: pointer;
            border: none;
            background: none;
            padding: 0;
            width: 30px;
            height: 30px;
        }

        .modal-close:hover {
            color: #7f8c8d;
        }

        .goal-edit-item {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            align-items: center;
        }

        .goal-edit-item input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }

        .goal-edit-item button {
            padding: 8px 12px;
            font-size: 13px;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        @media (max-width: 768px) {
            .container {
                padding: 12px;
            }

            .header {
                flex-direction: column;
                gap: 12px;
            }

            .week-selector {
                flex-direction: column;
                align-items: stretch;
            }

            .layer-tabs {
                overflow-x: auto;
                flex-wrap: nowrap;
            }

            .layer-tab {
                white-space: nowrap;
            }

            .modal-content {
                width: 95%;
                padding: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 主页面 -->
        <div id="main-view">
            <div class="header">
                <h1>📊 复盘中心</h1>
                <button class="btn btn-secondary" onclick="window.location.href='时间管理助手.html'">← 返回周表</button>
            </div>

            <!-- 长远目标 -->
            <div class="card">
                <h2>🎯 长远目标</h2>
                <ul class="goals-list" id="goals-list">
                    <li>加载中...</li>
                </ul>
                <button class="btn btn-secondary" onclick="editGoals()" style="margin-top: 12px;">编辑目标</button>
            </div>

            <!-- 开始复盘 -->
            <div class="card">
                <h2>📅 开始复盘</h2>
                <div class="week-selector">
                    <span>选择周范围：</span>
                    <select id="year-select">
                        <option value="2026">2026年</option>
                        <option value="2025">2025年</option>
                    </select>
                    <span>第</span>
                    <select id="start-week-select"></select>
                    <span>周 至 第</span>
                    <select id="end-week-select"></select>
                    <span>周</span>
                </div>
                <div id="date-range-display" style="margin-top: 12px; padding: 12px; background: #f8f9fa; border-radius: 6px; color: #7f8c8d; font-size: 14px; display: none;">
                    <!-- 日期范围会动态显示在这里 -->
                </div>
                <div class="quick-select">
                    <button class="btn btn-secondary" onclick="quickSelectThisMonth()">本月</button>
                    <button class="btn btn-secondary" onclick="quickSelectLastMonth()">上月</button>
                    <button class="btn btn-secondary" onclick="quickSelectLast4Weeks()">最近4周</button>
                </div>
                <button class="btn btn-primary" onclick="startAnalysis()" style="margin-top: 16px;">开始四层分析</button>
            </div>

            <!-- 历史复盘 -->
            <div class="card">
                <h2>📚 历史复盘</h2>
                <div id="history-list">
                    <p style="color: #95a5a6;">暂无历史复盘记录</p>
                </div>
            </div>
        </div>

        <!-- 分析页面 -->
        <div id="analysis-view">
            <div class="header">
                <h1 id="analysis-title">复盘分析</h1>
                <button class="btn btn-secondary" onclick="backToMain()">← 返回复盘中心</button>
            </div>

            <div class="card">
                <div class="layer-tabs">
                    <button class="layer-tab active" data-layer="1" onclick="switchLayer(1)">第1层：对比镜</button>
                    <button class="layer-tab" data-layer="2" onclick="switchLayer(2)">第2层：时间尺度</button>
                    <button class="layer-tab" data-layer="3" onclick="switchLayer(3)">第3层：位置地图</button>
                    <button class="layer-tab" data-layer="4" onclick="switchLayer(4)">第4层：目标对齐</button>
                </div>

                <!-- 第1层 -->
                <div id="layer-1" class="layer-content active">
                    <h2>第1层：对比镜</h2>
                    <p style="color: #7f8c8d; margin-bottom: 16px;">用数据对抗主观感受，破除内耗的错觉</p>

                    <div class="feelings-input">
                        <label style="display: block; margin-bottom: 8px; font-weight: bold;">💭 本周期感受（可选填写）</label>
                        <textarea id="feelings-textarea" placeholder="例如：这段时间感觉焦虑、低效、又在拖延了..."></textarea>
                        <button class="btn btn-primary" onclick="refreshLayer1()" style="margin-top: 8px;">🔄 刷新数据分析</button>
                    </div>

                    <div class="data-stats">
                        <h3>📊 数据显示</h3>
                        <ul class="stats-list" id="stats-list"></ul>
                    </div>

                    <div class="trend-chart">
                        <h3>📈 数据趋势</h3>
                        <div id="trend-display"></div>
                    </div>

                    <div class="contrast">
                        <h3>💡 反差分析</h3>
                        <ul class="contrast-list" id="contrast-list"></ul>
                    </div>

                    <div class="layer-navigation">
                        <div></div>
                        <button class="btn btn-primary" onclick="switchLayer(2)">下一层：时间尺度 →</button>
                    </div>
                </div>

                <!-- 第2层 -->
                <div id="layer-2" class="layer-content">
                    <h2>第2层：时间尺度切换器</h2>
                    <p style="color: #7f8c8d; margin-bottom: 16px;">拉长时间维度，从当下跳到长远</p>
                    <div id="layer-2-content"></div>
                    <div class="layer-navigation">
                        <button class="btn btn-secondary" onclick="switchLayer(1)">← 上一层</button>
                        <button class="btn btn-primary" onclick="switchLayer(3)">下一层：位置地图 →</button>
                    </div>
                </div>

                <!-- 第3层 -->
                <div id="layer-3" class="layer-content">
                    <h2>第3层：位置地图</h2>
                    <p style="color: #7f8c8d; margin-bottom: 16px;">你从哪来，你在哪，你往哪去</p>
                    <div id="layer-3-content"></div>
                    <div class="layer-navigation">
                        <button class="btn btn-secondary" onclick="switchLayer(2)">← 上一层</button>
                        <button class="btn btn-primary" onclick="switchLayer(4)">下一层：目标对齐 →</button>
                    </div>
                </div>

                <!-- 第4层 -->
                <div id="layer-4" class="layer-content">
                    <h2>第4层：目标对齐检查</h2>
                    <p style="color: #7f8c8d; margin-bottom: 16px;">当前轨迹是否服务于长远目标</p>
                    <div id="layer-4-content"></div>
                    <div class="layer-navigation">
                        <button class="btn btn-secondary" onclick="switchLayer(3)">← 上一层</button>
                        <button class="btn btn-primary" onclick="saveReview()">保存复盘 & 导出PDF</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 目标编辑模态框 -->
    <div id="goal-edit-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>🎯 编辑长远目标</h2>
                <button class="modal-close" onclick="closeGoalModal()">×</button>
            </div>
            <div id="goal-edit-list"></div>
            <button class="btn btn-secondary" onclick="addGoalInput()" style="margin-top: 12px;">+ 添加目标</button>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeGoalModal()">取消</button>
                <button class="btn btn-primary" onclick="saveGoals()">保存</button>
            </div>
        </div>
    </div>

    <script src="app-core.js"></script>
    <script src="review-engine.js"></script>
    <script src="review-ui.js"></script>
</body>
</html>
