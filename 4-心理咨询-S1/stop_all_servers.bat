@echo off
chcp 65001 >nul
echo ============================================================
echo   心理咨询-S1 全部服务器停止
echo ============================================================
echo.

set PORTS=5001 8003 8004 8005 8006 8007 8765 8766 8767 8768 8769 8770

for %%p in (%PORTS%) do (
    for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%%p " ^| findstr "LISTENING"') do (
        echo 停止端口 %%p (PID: %%a)...
        taskkill /F /PID %%a >nul 2>&1
    )
)

echo.
echo ============================================================
echo   所有服务器已停止！
echo ============================================================
echo.
pause
